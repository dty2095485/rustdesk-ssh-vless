# Copy this file to .env and keep the populated file out of source control.
IMAGE_TAG=rustdesk-server-combined:canary
S6_ARCH=x86_64

# Public hbbr address advertised by hbbs, including the port.
RELAY=
ENCRYPTED_ONLY=0
RUST_LOG=info

# Supply the credential only in the untracked .env file.
VLESS_UUID=

# Absolute host paths. Do not paste certificate or private-key contents here.
TLS_CERT_FILE=
TLS_KEY_FILE=

VLESS_TLS_HANDSHAKE_TIMEOUT_SECS=10
VLESS_HEADER_TIMEOUT_SECS=10
VLESS_UPSTREAM_CONNECT_TIMEOUT_SECS=5
VLESS_MAX_CONNECTIONS=1024

# SSH gateway. The client ships with a built-in ed25519 identity, so no
# authorized-keys file is required unless you want to add extra keys.
SSH_HOST_PORT=22
SSH_AUTHORIZED_KEYS=

