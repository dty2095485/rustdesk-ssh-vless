# Copy this file to .env and keep the populated file out of source control.
IMAGE_TAG=rustdesk-server-combined:canary
CONTAINER_NAME=rustdesk-server-canary
# amd64 VPS: use WSL-built binaries. For native arm64/source builds, set this
# to docker-combined/Dockerfile and S6_ARCH=aarch64.
DOCKERFILE=docker-combined/Dockerfile.runtime
RUSTDESK_BASE_IMAGE=rustdesk/rustdesk-server-s6:1.1.17-vless-combined-r2-ssh
XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v3.8.5@sha256:e0f90c10902e0e74f947d5a9efe017b273804477430233bbfc4918542ffe366c
S6_ARCH=x86_64
XUI_ENABLE_FAIL2BAN=false
XUI_DB_TYPE=
XUI_DB_DSN=
XUI_CERT_DIR=/root/my-app/ssl

# Public hbbr address advertised by hbbs, including the port.
RELAY=
ENCRYPTED_ONLY=0
RUST_LOG=info

# Supply the credential only in the untracked .env file.
VLESS_UUID=

# Absolute host paths. Do not paste certificate or private-key contents here.
TLS_CERT_FILE=
TLS_KEY_FILE=

VLESS_TLS_HANDSHAKE_TIMEOUT_SECS=10
VLESS_HEADER_TIMEOUT_SECS=10
VLESS_UPSTREAM_CONNECT_TIMEOUT_SECS=5
VLESS_MAX_CONNECTIONS=1024

# SSH gateway. The client ships with a built-in ed25519 identity, so no
# authorized-keys file is required unless you want to add extra keys.
SSH_HOST_PORT=2222
SSH_AUTHORIZED_KEYS=
