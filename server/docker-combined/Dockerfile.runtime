# syntax=docker/dockerfile:1.7

# Fast production image for the amd64 VPS. The Rust binaries are compiled and
# tested in WSL, while the currently deployed s6/glibc runtime remains the
# compatibility base. The full source-build Dockerfile is kept as Dockerfile.
ARG XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v3.8.5@sha256:e0f90c10902e0e74f947d5a9efe017b273804477430233bbfc4918542ffe366c
ARG RUSTDESK_BASE_IMAGE=rustdesk/rustdesk-server-s6:1.1.17-vless-combined-r2-ssh
FROM ${XUI_IMAGE} AS xui

FROM ${RUSTDESK_BASE_IMAGE}

COPY docker-combined/bin/linux-amd64/hbbs /usr/bin/hbbs
COPY docker-combined/bin/linux-amd64/hbbr /usr/bin/hbbr
COPY docker-combined/bin/linux-amd64/hbvless /usr/bin/hbvless
COPY docker-combined/bin/linux-amd64/hbssh /usr/bin/hbssh
COPY docker-combined/bin/linux-amd64/rustdesk-utils /usr/bin/rustdesk-utils
COPY docker-combined/bin/linux-amd64/runtime-libs/libgcc_s.so.1 /lib/libgcc_s.so.1
COPY --from=xui /app /app
# 3x-ui is a small dynamically linked musl binary, while the proven
# RustDesk runtime is glibc-based. Keeping the two loaders side-by-side is
# safe and avoids replacing either runtime's libc.
COPY --from=xui /lib/ld-musl-x86_64.so.1 /lib/libc.musl-x86_64.so.1 /lib/
COPY docker-combined/rootfs /

RUN chmod 0755 \
    /usr/bin/hbbs \
    /usr/bin/hbbr \
    /usr/bin/hbvless \
    /usr/bin/hbssh \
    /usr/bin/rustdesk-utils \
    /etc/s6-overlay/s6-rc.d/hbbs/run \
    /etc/s6-overlay/s6-rc.d/hbbr/run \
    /etc/s6-overlay/s6-rc.d/hbvless/run \
    /etc/s6-overlay/s6-rc.d/hbssh/run \
    /etc/s6-overlay/s6-rc.d/reality-ui/run \
    /etc/s6-overlay/s6-rc.d/key-secret/up.real \
    /usr/bin/healthcheck-combined.sh \
    /app/DockerEntrypoint.sh \
    /app/x-ui

ENV RELAY="" \
    ENCRYPTED_ONLY=0 \
    VLESS_LISTEN=127.0.0.1:8443 \
    VLESS_NAT=127.0.0.1:22115 \
    VLESS_HBBS=127.0.0.1:22116 \
    VLESS_HBBR=127.0.0.1:22117 \
    VLESS_NAT_INTERNAL=127.0.0.1:22115 \
    VLESS_HBBS_INTERNAL=127.0.0.1:22116 \
    VLESS_HBBR_INTERNAL=127.0.0.1:22117 \
    VLESS_CERT=/run/tls/fullchain.pem \
    VLESS_KEY=/run/tls/privkey.pem \
    SSH_LISTEN=0.0.0.0:2222 \
    SSH_NAT=127.0.0.1:22115 \
    SSH_HBBS=127.0.0.1:22116 \
    SSH_HBBR=127.0.0.1:22117 \
    XUI_IN_DOCKER=true \
    XUI_MAIN_FOLDER=/app \
    XUI_PORT=2053 \
    XRAY_VMESS_AEAD_FORCED=false \
    XUI_ENABLE_FAIL2BAN=false \
    XUI_DB_TYPE= \
    XUI_DB_DSN=

EXPOSE 21115/tcp 21116/tcp 21116/udp 21117/tcp 21118/tcp 21119/tcp 8443/tcp 10443/tcp 2053/tcp 2222/tcp

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["/usr/bin/healthcheck-combined.sh"]

WORKDIR /data
VOLUME ["/data", "/etc/x-ui", "/root/.acme.sh"]
ENTRYPOINT ["/init"]
